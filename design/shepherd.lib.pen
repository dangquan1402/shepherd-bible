{
  "version": "2.19",
  "children": [
    {
      "type": "frame",
      "id": "board_shepherd_lib",
      "name": "Shepherd Library Board",
      "x": 0,
      "y": 0,
      "fill": "$--color-canvas-bg",
      "layout": "vertical",
      "gap": 32,
      "padding": 40,
      "children": [
        {
          "type": "frame",
          "id": "comp_nav_toolbar",
          "name": "Nav/GlassToolbar",
          "reusable": true,
          "width": 370,
          "height": 44,
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "nav_leading_btn",
              "name": "LeadingBtn",
              "width": 44,
              "height": 44,
              "cornerRadius": "$--radius-pill",
              "fill": "$--color-glass-fill",
              "stroke": "$--color-glass-stroke",
              "strokeWidth": 1,
              "effect": [
                {
                  "type": "background_blur",
                  "radius": 16
                },
                {
                  "type": "shadow",
                  "shadowType": "outer",
                  "color": "$--color-shadow-glass",
                  "offset": {
                    "x": 0,
                    "y": 2
                  },
                  "blur": 8
                }
              ],
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "nav_leading_icon",
                  "name": "Icon",
                  "width": 20,
                  "height": 20,
                  "icon": "chevron-left",
                  "library": "lucide",
                  "fill": "$--color-text-primary"
                }
              ]
            },
            {
              "type": "text",
              "id": "nav_title",
              "name": "Title",
              "content": "Today",
              "fontFamily": "$--font-sans",
              "fontSize": "$--text-headline",
              "fontWeight": "$--weight-semibold",
              "fill": "$--color-text-primary"
            },
            {
              "type": "frame",
              "id": "nav_trailing_btn",
              "name": "TrailingBtn",
              "width": 44,
              "height": 44,
              "cornerRadius": "$--radius-pill",
              "fill": "$--color-glass-fill",
              "stroke": "$--color-glass-stroke",
              "strokeWidth": 1,
              "effect": [
                {
                  "type": "background_blur",
                  "radius": 16
                },
                {
                  "type": "shadow",
                  "shadowType": "outer",
                  "color": "$--color-shadow-glass",
                  "offset": {
                    "x": 0,
                    "y": 2
                  },
                  "blur": 8
                }
              ],
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "nav_trailing_icon",
                  "name": "Icon",
                  "width": 20,
                  "height": 20,
                  "icon": "bookmark",
                  "library": "lucide",
                  "fill": "$--color-accent"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "comp_nav_tabbar",
          "name": "Nav/GlassTabBar",
          "reusable": true,
          "width": 370,
          "height": 56,
          "cornerRadius": "$--radius-pill",
          "fill": "$--color-glass-fill",
          "stroke": "$--color-glass-stroke",
          "strokeWidth": 1,
          "effect": [
            {
              "type": "background_blur",
              "radius": 24
            },
            {
              "type": "shadow",
              "shadowType": "outer",
