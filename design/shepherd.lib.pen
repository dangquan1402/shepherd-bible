            {
              "type": "text",
              "id": "verse_text",
              "name": "VerseText",
              "content": "\"In the beginning, God created the heavens and the earth.\"",
              "fontFamily": "$--font-serif",
              "fontSize": "$--text-body",
              "fontWeight": "$--weight-regular",
              "fill": "$--color-text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "comp_row_choice",
