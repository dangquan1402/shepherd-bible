            },
            {
              "type": "frame",
              "id": "tab_lamb",
              "name": "TabLamb",
              "layout": "vertical",
              "alignItems": "center",
              "gap": 2,
              "children": [
                {
                  "type": "icon",
                  "id": "tab_icon_lamb",
                  "name": "Icon",
                  "width": 22,
                  "height": 22,
                  "icon": "heart",
                  "library": "lucide",
                  "fill": "$--color-text-tertiary"
                },
                {
                  "type": "text",
                  "id": "tab_label_lamb",
                  "name": "Label",
                  "content": "Lamb",
                  "fontFamily": "$--font-sans",
                  "fontSize": "$--text-xs",
                  "fontWeight": "$--weight-medium",
                  "fill": "$--color-text-tertiary"
                }
              ]
            },
            {
              "type": "frame",
              "id": "tab_settings",
              "name": "TabSettings",
              "layout": "vertical",
              "alignItems": "center",
              "gap": 2,
              "children": [
                {
                  "type": "icon",
                  "id": "tab_icon_settings",
                  "name": "Icon",
                  "width": 22,
                  "height": 22,
                  "icon": "settings",
                  "library": "lucide",
                  "fill": "$--color-text-tertiary"
                },
                {
                  "type": "text",
                  "id": "tab_label_settings",
                  "name": "Label",
                  "content": "Settings",
                  "fontFamily": "$--font-sans",
                  "fontSize": "$--text-xs",
                  "fontWeight": "$--weight-medium",
                  "fill": "$--color-text-tertiary"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "comp_bottom_accessory",
          "name": "Nav/BottomAccessory",
          "reusable": true,
          "width": 370,
          "height": 52,
          "cornerRadius": "$--radius-pill",
          "fill": "$--color-glass-fill",
