          "padding": [
            0,
            16
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "acc_left",
              "name": "LeftMeta",
              "layout": "vertical",
              "gap": 1,
