                  "fontSize": "$I:--text-caption",
                  "fontWeight": "$I:--weight-bold"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_5",
                  "name": "VerseText",
                  "textGrowth": "fixed-width",
                  "width": 320,
                  "fill": "$I:--color-text-primary",
                  "content": "God called the light \"day\", and the darkness he called \"night\". There was evening and there was morning, the first day.",
                  "fontFamily": "$I:--font-serif",
                  "fontSize": "$I:--text-body",
                  "lineHeight": 1.4
                }
              ]
            }
