                  "id": "bible_reader_dark_vnum_3",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "content": "4",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 12,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_3",
                  "name": "VerseBody",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "God saw the light, and saw that it was good. God divided the light from the darkness.",
                  "lineHeight": 1.3,
                  "fontFamily": "$I:--font-display",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
