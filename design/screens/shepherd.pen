                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_ch",
                  "fill": "$I:--color-text-primary",
                  "content": "Genesis 1",
                  "fontFamily": "$I:--font-sans",
                  "fontSize": "$I:--text-title1",
                  "fontWeight": "$I:--weight-bold"
                }
              ]
            },
            {
              "type": "frame",
              "id": "bible_reader_dark_vrow_1",
              "name": "VerseRow_1",
              "gap": 10,
              "width": 354,
              "children": [
                {
                  "type": "text",
                  "id": "bible_reader_dark_vnum_1",
                  "fill": "$I:--color-accent",
                  "content": "1",
                  "fontFamily": "$I:--font-sans",
                  "fontSize": "$I:--text-caption",
                  "fontWeight": "$I:--weight-bold"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_1",
                  "name": "VerseText",
                  "textGrowth": "fixed-width",
                  "width": 320,
                  "fill": "$I:--color-text-primary",
                  "content": "In the beginning, God created the heavens and the earth.",
                  "fontFamily": "$I:--font-serif",
                  "fontSize": "$I:--text-body",
                  "lineHeight": 1.4
                }
              ]
            },
            {
              "type": "frame",
              "id": "bible_reader_dark_vrow_2",
              "name": "VerseRow_2",
              "gap": 10,
              "width": 354,
              "children": [
                {
                  "type": "text",
                  "id": "bible_reader_dark_vnum_2",
                  "fill": "$I:--color-accent",
                  "content": "2",
                  "fontFamily": "$I:--font-sans",
                  "fontSize": "$I:--text-caption",
                  "fontWeight": "$I:--weight-bold"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_2",
                  "name": "VerseText",
                  "textGrowth": "fixed-width",
                  "width": 320,
                  "fill": "$I:--color-text-primary",
                  "content": "The earth was formless and empty. Darkness was on the surface of the deep and God's Spirit was hovering over the surface of the waters.",
                  "fontFamily": "$I:--font-serif",
                  "fontSize": "$I:--text-body",
                  "lineHeight": 1.4
                }
              ]
            },
            {
              "type": "frame",
              "id": "bible_reader_dark_vrow_3",
              "name": "VerseRow_3",
              "gap": 10,
              "width": 354,
