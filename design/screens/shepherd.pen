                  "content": "4",
                  "fontFamily": "$I:--font-sans",
                  "fontSize": "$I:--text-caption",
                  "fontWeight": "$I:--weight-bold"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_4",
                  "name": "VerseText",
                  "textGrowth": "fixed-width",
                  "width": 320,
                  "fill": "$I:--color-text-primary",
                  "content": "God saw the light, and saw that it was good. God divided the light from the darkness.",
                  "fontFamily": "$I:--font-serif",
                  "fontSize": "$I:--text-body",
                  "lineHeight": 1.4
                }
              ]
            },
            {
              "type": "frame",
              "id": "bible_reader_dark_vrow_5",
