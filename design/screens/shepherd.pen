              "width": 362,
              "height": 84,
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "bible_reader_dark_vnum_2",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "content": "3",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 12,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_2",
                  "name": "VerseBody",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "God said, \"Let there be light,\" and there was light.",
                  "lineHeight": 1.3,
                  "fontFamily": "$I:--font-display",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
