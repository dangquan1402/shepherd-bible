              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "xH8ZB",
              "name": "ChapterTitle",
              "fill": "$I:--color-text-primary",
              "content": "Genesis 1",
              "fontFamily": "$I:--font-display",
              "fontSize": 34,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "h3SLy",
              "name": "Verse 1",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "riMNw",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "textGrowth": "fixed-width",
                  "width": 18,
                  "content": "1",
                  "textAlign": "right",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 13,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "R5asn6",
                  "name": "VerseText",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "In the beginning, God created the heavens and the earth.",
                  "lineHeight": 1.5,
                  "fontFamily": "$I:--font-display",
                  "fontSize": 19,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "CPopq",
              "name": "Verse 2",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "D4Tb8",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "textGrowth": "fixed-width",
                  "width": 18,
                  "content": "2",
                  "textAlign": "right",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 13,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "dRFyD",
                  "name": "VerseText",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The earth was formless and empty. Darkness was on the surface of the deep and God's Spirit was hovering over the surface of the waters.",
                  "lineHeight": 1.5,
                  "fontFamily": "$I:--font-display",
                  "fontSize": 19,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Vxoax",
              "name": "Verse 3",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "cM1ak",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "textGrowth": "fixed-width",
                  "width": 18,
                  "content": "3",
                  "textAlign": "right",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 13,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "X94OFV",
                  "name": "VerseText",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "God said, \"Let there be light,\" and there was light.",
                  "lineHeight": 1.5,
                  "fontFamily": "$I:--font-display",
                  "fontSize": 19,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "sQOPE",
              "name": "Verse 4",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "cB3EN",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "textGrowth": "fixed-width",
                  "width": 18,
                  "content": "4",
                  "textAlign": "right",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 13,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "OLFm3",
                  "name": "VerseText",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "God saw the light, and saw that it was good. God divided the light from the darkness.",
                  "lineHeight": 1.5,
                  "fontFamily": "$I:--font-display",
                  "fontSize": 19,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "J1H9uY",
              "name": "Verse 5",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "SZfCJ",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "textGrowth": "fixed-width",
                  "width": 18,
                  "content": "5",
                  "textAlign": "right",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 13,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "vykUF",
                  "name": "VerseText",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
