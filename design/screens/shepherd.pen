                  "name": "VerseBody",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "God called the light \"day\", and the darkness he called \"night\". There was evening and there was morning, the first day.",
