                {
                  "type": "text",
                  "id": "bible_reader_dark_vnum_3",
                  "fill": "$I:--color-accent",
                  "content": "3",
                  "fontFamily": "$I:--font-sans",
                  "fontSize": "$I:--text-caption",
                  "fontWeight": "$I:--weight-bold"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_3",
                  "name": "VerseText",
                  "textGrowth": "fixed-width",
                  "width": 320,
                  "fill": "$I:--color-text-primary",
                  "content": "God said, \"Let there be light,\" and there was light.",
                  "fontFamily": "$I:--font-serif",
                  "fontSize": "$I:--text-body",
                  "lineHeight": 1.4
                }
              ]
            },
            {
              "type": "frame",
              "id": "bible_reader_dark_vrow_4",
              "name": "VerseRow_4",
              "gap": 10,
