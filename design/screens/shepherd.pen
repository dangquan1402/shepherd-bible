              "width": 362,
              "height": 84,
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "bible_reader_dark_vnum_1",
                  "name": "VerseNum",
                  "fill": "$I:--color-accent",
                  "content": "2",
                  "fontFamily": "$I:--font-body",
                  "fontSize": 12,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "bible_reader_dark_vtxt_1",
                  "name": "VerseBody",
                  "fill": "$I:--color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The earth was formless and empty. Darkness was on the surface of the deep and God's Spirit was hovering over the surface of the waters.",
                  "lineHeight": 1.3,
                  "fontFamily": "$I:--font-display",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "bible_reader_dark_v_2",
